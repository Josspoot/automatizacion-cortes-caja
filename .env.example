# Copia este archivo a .env y llena tus propios valores.
# Ninguno de estos datos se sube al repo (.env esta en .gitignore).

# URL base de tu ERP/plataforma web (sin /movimientos al final)
CORTES_URL_BASE=https://tu-erp.ejemplo.com

# Ruta a tu libro Excel con macros donde tambien se registra el doble-registro
# (deja esta linea comentada si no usas la parte de Excel)
# CORTES_XLSM_PATH=/Users/tu-usuario/Documents/Mi Libro Contable.xlsm

# Rutas opcionales (si no las defines, usan valores por defecto dentro del repo)
# CORTES_PERFIL_NAVEGADOR=.perfil_navegador
# CORTES_PDF_DIR=cortes_pdf
# CORTES_CONOCIMIENTO_PATH=conocimiento.json
# CORTES_CONOCIMIENTO_EXCEL_PATH=conocimiento_excel.json
# CORTES_CATEGORIAS_PATH=categorias.json
# CORTES_REGISTRO_PATH=registro.json
# CORTES_REGISTRO_REPORTE_PATH=registro_reporte.json
